# ==============================================================================
# IP-SAKTI Sahayak — Environment Configuration Template
# ==============================================================================

# Supabase Authentication & Database Configuration
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Models Key (Google Gemini API / Vertex AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Database (Chroma / Qdrant / Pinecone)
VECTOR_DB_URL=http://localhost:8000
VECTOR_DB_COLLECTION=ip_sakti_legal_chunks

# App Environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
