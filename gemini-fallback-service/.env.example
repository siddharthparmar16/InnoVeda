# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Gemini Fallback Chain — Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Comma-separated list of Gemini API keys (add as many as you want)
GEMINI_API_KEYS=AIzaSyXXXXXX_key1,AIzaSyXXXXXX_key2,AIzaSyXXXXXX_key3

# Default model to use for all requests
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# Max retries PER KEY before it enters cooldown and we fallback to next key
MAX_RETRIES_PER_KEY=2

# How long (seconds) a failed key stays in cooldown before becoming active again
KEY_COOLDOWN_SECONDS=60

# Request timeout in milliseconds (passed to google-genai httpx client)
REQUEST_TIMEOUT_MS=30000

# Server configuration
HOST=0.0.0.0
PORT=8000
